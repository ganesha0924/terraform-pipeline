pipeline {
    agent any

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Target environment to DESTROY')
    }

    environment {
        TF_DIR = "environments/${params.ENVIRONMENT}"
    }

    options {
        ansiColor('xterm')
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform init -input=false'
                }
            }
        }

        stage('Terraform Plan Destroy') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform plan -destroy -out=tfplan-destroy -input=false'
                }
            }
        }

        stage('Confirm Destroy') {
            steps {
                input message: "⚠️ This will DESTROY all resources in ${params.ENVIRONMENT}. Are you absolutely sure?", submitter: ''
            }
        }

        stage('Terraform Destroy') {
            steps {
                dir("${TF_DIR}") {
                    sh 'terraform apply -input=false tfplan-destroy'
                }
            }
        }
    }

    post {
        success {
            echo "🗑️ ${params.ENVIRONMENT} destroyed"
        }
        failure {
            echo "❌ Destroy failed — check logs"
        }
    }
}
